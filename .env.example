# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# In Docker, we use the container hostname 'postgres' inside the network.
# If running locally (non-containerized), change 'postgres' back to 'localhost' or '127.0.0.1'.
DB_USER=vaultr
DB_PASSWORD=changeme_use_strong_password
DB_NAME=vaultr_db
DATABASE_URL=postgresql://vaultr:changeme_use_strong_password@postgres:5432/vaultr_db

# ─── MinIO (S3-compatible file storage) ───────────────────────────────────────
# This must be the address the user's web browser uses to access MinIO (public URL or server IP).
# If using a domain: https://minio.yourdomain.com
# If using IP: http://YOUR_SERVER_IP:9005
MINIO_ENDPOINT=http://localhost:9005
MINIO_ROOT_USER=vaultr
MINIO_ROOT_PASSWORD=changeme_use_strong_password
MINIO_BUCKET_AVATARS=avatars

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
BETTER_AUTH_SECRET=
# Set this to your primary domain (e.g. https://vaultr.yourdomain.com) or primary IP address.
BETTER_AUTH_URL=http://localhost:3005

# ─── Google OAuth (optional — leave empty to disable Google sign-in) ──────────
# Setup: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
# Set this to your primary domain (e.g. https://vaultr.yourdomain.com) or primary IP address.
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ─── Trusted Origins (CORS) ───────────────────────────────────────────────────
# If you plan to access your app from multiple domains or IP addresses in the future,
# list all of them here as a comma-separated list.
# Example: TRUSTED_ORIGINS=https://vaultr.yourseconddomain.com,http://192.168.1.100:3005
TRUSTED_ORIGINS=
