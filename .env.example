# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by: Next.js app (Drizzle ORM), Docker container
DB_USER=vaultr
DB_PASSWORD=changeme_use_strong_password
DB_NAME=vaultr_db
DATABASE_URL=postgresql://vaultr:changeme_use_strong_password@localhost:5432/vaultr_db

# ─── MinIO (S3-compatible file storage) ───────────────────────────────────────
# Console UI: http://localhost:9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=vaultr
MINIO_ROOT_PASSWORD=changeme_use_strong_password
MINIO_BUCKET_AVATARS=avatars

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (optional — leave empty to disable Google sign-in) ──────────
# Setup: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Trusted Origins (CORS) ───────────────────────────────────────────────────
# Comma-separated list of additional origins to trust for cross-origin requests.
# Use this for LAN access during development (e.g. testing on a phone/tablet).
# Do NOT use wildcards — list each origin explicitly.
# Example: TRUSTED_ORIGINS=http://192.168.1.100:3000,http://192.168.1.101:3000
TRUSTED_ORIGINS=
