<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="36dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_quick_autofill_sheet"
        android:paddingTop="12dp">

        <!-- Top Drag Pill -->
        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="#333542"
            android:layout_marginBottom="12dp" />

        <!-- Search & Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="10dp"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_input"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search_clean"
                    android:contentDescription="Search"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/search_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Search vault..."
                    android:textColorHint="#52525B"
                    android:textColor="#F4F4F5"
                    android:textSize="14sp"
                    android:background="@null"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageButton
                    android:id="@+id/btn_clear_search"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_close_clean"
                    android:background="@null"
                    android:contentDescription="Clear"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_search"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_close_clean"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Detected Context Subtitle -->
        <TextView
            android:id="@+id/text_detected_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap any account to autofill"
            android:textColor="#71717A"
            android:textSize="12sp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/search_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No matching credentials found."
            android:textColor="#52525B"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <!-- Results List -->
        <ListView
            android:id="@+id/search_results_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
