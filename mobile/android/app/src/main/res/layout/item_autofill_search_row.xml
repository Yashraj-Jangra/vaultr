<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Avatar / Initial Icon Box -->
    <TextView
        android:id="@+id/search_item_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_search_input"
        android:gravity="center"
        android:text="V"
        android:textColor="#F4F4F5"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/search_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Google Account"
            android:textColor="#F4F4F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/search_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@gmail.com"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Quick Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 1-Tap Fill Button -->
        <Button
            android:id="@+id/btn_action_fill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Fill"
            android:textColor="#09090b"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_fill"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="6dp" />

        <!-- Copy Menu / Button -->
        <ImageButton
            android:id="@+id/btn_action_copy"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_copy_mini"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Copy password" />
    </LinearLayout>
</LinearLayout>
