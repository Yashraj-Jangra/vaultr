<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Account Icon -->
    <ImageView
        android:id="@+id/search_item_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_vaultr_lock_small"
        android:contentDescription="Vaultr"
        android:layout_marginEnd="12dp" />

    <!-- Text Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/search_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Account Name"
            android:textColor="#F4F4F5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/search_item_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username@example.com"
            android:textColor="#A1A1AA"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Quick Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_copy_user"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="User"
            android:textSize="11sp"
            android:textColor="#F4F4F5"
            android:background="#18181b"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btn_copy_pass"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Pass"
            android:textSize="11sp"
            android:textColor="#09090b"
            android:background="#F4F4F5"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:minHeight="0dp"
            android:minWidth="0dp" />
    </LinearLayout>

</LinearLayout>
