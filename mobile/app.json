{
  "expo": {
    "name": "Vaultr",
    "slug": "vaultr-mobile",
    "scheme": "vaultr",
    "version": "0.2.12",
    "orientation": "portrait",
    "icon": "./assets/vaultr-lock-dark-solid.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#09090b"
      },
      "package": "com.vaultr.mobile",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 12
    },
    "ios": {
      "bundleIdentifier": "com.vaultr.mobile",
      "buildNumber": "12",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Vaultr to use Face ID to unlock your secure vault.",
        "NSCameraUsageDescription": "Allow Vaultr to access camera to scan 2FA QR codes.",
        "NSPhotoLibraryUsageDescription": "Allow Vaultr to access your photo library for vault attachments.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Vaultr to use Face ID to unlock your secure vault."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Vaultr to access camera to scan 2FA QR codes.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "b0aea119-3227-44cb-91f3-b0fc1715b3db"
      }
    }
  }
}
