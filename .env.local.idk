# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# In Docker, we use the container hostname 'postgres' inside the network.
# If running locally (non-containerized), change 'postgres' back to 'localhost' or '127.0.0.1'.
DB_USER=vaultr
DB_PASSWORD=vsFK3NpzQUQMNHR
DB_NAME=vaultr_db
DATABASE_URL=postgresql://vaultr:vsFK3NpzQUQMNHR@127.0.0.1:5435/vaultr_db

# ─── MinIO (S3-compatible file storage) ───────────────────────────────────────
# MINIO_ENDPOINT is overridden to http://minio:9000 inside Docker by docker-compose.yml
# (the app container uses the internal Docker network to talk to MinIO — do not change that).
# This value below is only used when running outside Docker (local dev without containers).
# Since you are SSH tunneling, use the localhost loopback port 9005.
MINIO_ENDPOINT=http://127.0.0.1:9005

# MINIO_PUBLIC_URL: the address the USER'S BROWSER uses to load files (avatars, etc).
# This is your public-facing MinIO / reverse proxy domain.
MINIO_PUBLIC_URL=https://apivaultr.cvweb.qzz.io

MINIO_ROOT_USER=vaultr
MINIO_ROOT_PASSWORD=vsFK3NpzQUQMNHR
MINIO_BUCKET_AVATARS=avatars

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
BETTER_AUTH_SECRET=afdc558f5f661b3b1270dc3a3596832db2c30cf111d8640e57e819473f1b4beb
# Set this to your local development URL to avoid origin errors (e.g., http://localhost:3000).
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth (optional — leave empty to disable Google sign-in) ──────────
# Setup: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── App ──────────────────────────────────────────────────────────────────────
# Set this to your local development URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Trusted Origins (CORS) ───────────────────────────────────────────────────
# If you plan to access your app from multiple domains or IP addresses in the future,
# list all of them here as a comma-separated list.
# Example: TRUSTED_ORIGINS=https://vaultr.yourseconddomain.com,http://192.168.1.150:3005
TRUSTED_ORIGINS=https://vaultr.cvweb.qzz.io,https://vaultr.myacc.qzz.io,http://localhost:3000
