{
  "manifest_version": 3,
  "name": "VaultR — Zero-Knowledge Password Vault",
  "short_name": "Vaultr",
  "version": "0.2.10",
  "description": "VaultR 2026 — Zero-knowledge, client-side encrypted password manager.",
  "icons": {
    "16": "icons/vaultr-lock-dark-transparent-16.png",
    "32": "icons/vaultr-lock-dark-transparent-32.png",
    "48": "icons/vaultr-lock-dark-transparent-48.png",
    "128": "icons/vaultr-lock-dark-transparent-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vaultr",
    "default_icon": {
      "16": "icons/vaultr-lock-dark-transparent-16.png",
      "32": "icons/vaultr-lock-dark-transparent-32.png",
      "48": "icons/vaultr-lock-dark-transparent-48.png",
      "128": "icons/vaultr-lock-dark-transparent-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "webauthn-page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "autofill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "alarms",
    "clipboardWrite",
    "privacy",
    "contextMenus"
  ],
  "commands": {
    "autofill_credential": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Autofill matching login credentials"
    },
    "copy_totp": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "Copy 2FA TOTP code to clipboard"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "brand/*",
        "illustrations/*",
        "webauthn-page.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
