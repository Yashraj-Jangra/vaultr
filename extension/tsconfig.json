{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["chrome"],
    "paths": {
      "@vaultr/core": ["../packages/core/src/index.ts"],
      "@vaultr/core/*": ["../packages/core/src/*"]
    }
  },
  "include": ["src/**/*"]
}
